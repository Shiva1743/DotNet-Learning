@model CreateRoleViewModel

@{
    ViewBag.Title = "User Role";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="card shadow">
                <div class="card-header text-center">
                    <h3 class="mb-0">Add User Roles</h3>
                </div>

                <div class="card-body">

                    <form asp-controller="Administration"
                          asp-action="CreateRole"
                          method="post">

                        <div asp-validation-summary="All"
                             class="text-danger mb-3">
                        </div>

                        <!-- RoleName -->
                        <div class="mb-3">
                            <label asp-for="RoleName"
                                   class="form-label">
                                RoleName
                            </label>

                            <input asp-for="RoleName"
                                   class="form-control" />

                            <span asp-validation-for="RoleName"
                                  class="text-danger">
                            </span>
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Save
                        </button>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>