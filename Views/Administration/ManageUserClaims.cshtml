@using System.Security.Claims
@model UserClaimsViewModel

@{
    var UserId = ViewBag.UserId;
}
<div class="container mt-5">
    <div class="row justify-content-center">
        <form method="post" asp-action="ManageUserClaims" asp-route-id="@UserId" asp-controller="Administration">
            <div class="card shadow">
                <!-- Header -->
                <div class="card-header text-center">
                    <h3 class="mb-0">Update User : @ViewBag.UserName Claims</h3>
                </div>
                <input type="hidden" asp-for="UserId" />
                <div class="card-body">
                    @for (int i = 0; i < Model.Claims.Count; i++)
                    {
                        <div class="form-check">
                            <input type="hidden" asp-for="@Model.Claims[i].ClaimType" />
                            <input asp-for="@Model.Claims[i].IsSelected" class="form-check-input" />
                            <label class="form-check-label" asp-for="@Model.Claims[i].IsSelected">
                                @Model.Claims[i].ClaimType
                            </label>
                        </div>
                    }
                    <div asp-validation-summary="All" class="text-danger"></div>
                </div>
                <div class="card-footer">
                    <input type="submit" value="Update" class="btn btn-primary" />
                    <a asp-action="EditUser" asp-route-id="@UserId" asp-controller="Administration" class="btn btn-dark">Cancel</a>
                </div>
            </div>
        </form>
</div>
</div>