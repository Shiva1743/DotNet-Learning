@model EditUserViewModel

@{
    ViewBag.Title = "Edit Users";
}

<h1>All Users</h1>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-12">
            <div class="card shadow">
                <div class="card m-3">
                    <div class="card-header">
                        User Id :
                        <input asp-for="@Model.Id" class="form-control" disabled />
                    </div>
                    <div asp-validation-summary="All" class="text-danger mb-1"></div>
                    <form asp-action="EditUser" asp-route-id="@Model.Id" method="post">
                        <div class="card-body">
                            <!-- Email -->
                            <div class="mb-3">
                                <label asp-for="@Model.Email" class="form-label">Email</label>
                                <input asp-for="@Model.Email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="@Model.UserName" class="form-label">UserName</label>
                                <input asp-for="@Model.UserName" class="form-control" />
                                <span asp-validation-for="UserName" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="@Model.City" class="form-label">City</label>
                                <input asp-for="@Model.City" class="form-control" />
                                <span asp-validation-for="City" class="text-danger"></span>
                            </div>
                            <button type="submit" class="btn btn-primary">Update</button>
                            <a asp-action="ListUsers" class="btn btn-danger">Cancel</a>
                        </div>
                    </form>
                    <hr />
                    <div class="card m-3">
                        <div class="card m-3">
                            <div class="card-header">
                                User Roles
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    @if (Model.Roles.Any())
                                    {
                                        foreach (var role in Model.Roles)
                                        {
                                            <div>@role</div>
                                        }
                                    }
                                    else
                                    {
                                        <div>No Data</div>
                                    }
                                </div>
                                <a asp-action="ManageUserRoles" asp-route-id="@Model.Id" class="btn btn-success">Manage Roles</a>
                            </div>
                        </div>
                    </div>

                    <hr />
                    <div class="card m-3">
                        <div class="card m-3">
                            <div class="card-header">
                                User Claims
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    @if (Model.Claims.Any())
                                    {
                                        foreach (var claim in Model.Claims)
                                        {
                                            <div>@claim</div>
                                        }
                                    }
                                    else
                                    {
                                        <div>No Data</div>
                                    }
                                </div>
                                <a asp-action="ManageUserClaims" asp-route-id="@Model.Id" class="btn btn-success">Manage Claims</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
