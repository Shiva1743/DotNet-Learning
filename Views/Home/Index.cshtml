@model IEnumerable<Employee>
@{
    ViewBag.Title = "Employee List";
}
    <h1>hello from index view from home folder</h1>
    <div>
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Department</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var employee in Model)
                {
                    <tr>
                        <td>@employee.Name</td>
                        <td>@employee.Email</td>
                        <td>@employee.Department</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
