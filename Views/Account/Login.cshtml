@model LoginViewModel

@{
    ViewBag.Title = "User Login";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="card shadow">
                <div class="card-header text-center">
                    <h3 class="mb-0">User Login</h3>
                </div>

                <div class="card-body">

                    <form asp-controller="Account"
                          asp-action="login"
                          method="post">
                        <input type="hidden" name="returnUrl" value="@(Model.ReturnUrl ?? "")" />
                        <div asp-validation-summary="All"
                             class="text-danger mb-3">
                        </div>

                        <!-- Email -->
                        <div class="mb-3">
                            <label asp-for="Email"
                                   class="form-label">
                                Email
                            </label>

                            <input asp-for="Email"
                                   class="form-control"
                                   placeholder="Enter your email" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- Password -->
                        <div class="mb-3">
                            <label asp-for="Password"
                                   class="form-label">
                                Password
                            </label>

                            <input asp-for="Password"
                                   class="form-control"
                                   placeholder="Enter password" />

                            <span asp-validation-for="Password"
                                  class="text-danger">
                            </span>
                        </div>
                        <!-- RememberMe -->
                        <div class="mb-3">
                            <div class="checkbox">
                                <label asp-for="RememberMe"
                                       class="form-label">
                                    <input asp-for="RememberMe" />
                                    @Html.DisplayNameFor(m => m.RememberMe)
                                </label>
                            </div>
                        </div>
                        <button type="submit"
                                class="btn btn-primary w-100">
                            Login
                        </button>
                        <a asp-action="ForgotPassword" asp-controller="Account" class=""> Forgot Password ??</a>
                    </form>

                </div>
            </div>
            <hr />
            <div class="col-md-6 col-lg-5">
                @{
                    if (Model.ExternalLogins.Count == 0)
                    {
                        <div>No external login configured</div>
                    }
                    else
                    {
                        <form method="post" asp-action="ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl">
                            <div>
                                @foreach (var provider in Model.ExternalLogins)
                                {
                                    <button type="submit" class="btn btn-primary w-100" name="provider" value="@provider.Name"
                                            title="Login with @provider.DisplayName account">
                                        @provider.DisplayName
                                    </button>
                                }
                            </div>
                        </form>
                    }
                }
            </div>
        </div>
    </div>
</div>