@if (ViewBag.ErrorTitle == null)
{
    ViewBag.Title = "Not Found";

    <h1>@ViewBag.ErrorMessage</h1>
    @* <h1>@ViewBag.Path</h1>
    <h1>@ViewBag.QS</h1> *@

    <a asp-action="index" asp-controller="home" class="btn btn-primary">
        Click here for navigate to home page
    </a>
}
else
{
    <h1 class="text-danger">@ViewBag.ErrorTitle</h1>
    <h6 class="text-danger">@ViewBag.ErrorMessage</h6>
}
